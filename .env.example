# IMPERIUM GYM — Variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# Ne JAMAIS committer `.env.local` (déjà dans .gitignore).

# ─── URL publique du site (utilisé pour sitemap, JSON-LD, canonicals) ──────
NEXT_PUBLIC_SITE_URL=https://imperium-gym.com

# ─── Resend — emails transactionnels (formulaire contact) ─────────────────
# https://resend.com/api-keys
# Nécessite un domaine vérifié (ex. imperium-gym.com) pour envoyer en prod.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email source (doit appartenir à un domaine vérifié sur Resend)
RESEND_FROM_EMAIL="IMPERIUM GYM <contact@imperium-gym.com>"

# Email destinataire des notifications du formulaire
CONTACT_EMAIL=contact@imperium-gym.com

# ─── Upstash Redis — rate-limit du formulaire contact ─────────────────────
# https://console.upstash.com/redis
# Si non configurées, le rate-limit passe en mode no-op (avertissement console).
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ─── Sportigo (gestion abonnements + paiement CB/SEPA + accès QR) ─────────
# Sportigo s'intègre par redirection ou widget — pas de clé API à exposer côté
# front. Si une intégration API serveur est mise en place plus tard, ajouter
# ici la clé fournie par Sportigo (https://www.sportigo.io).
# SPORTIGO_API_KEY=xxxxxxxxxxxxxxxxxxxx
